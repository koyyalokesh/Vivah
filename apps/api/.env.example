# Copy this file to .env and supply a development-only MongoDB database.
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/vivah_dev
APP_ORIGIN=http://localhost:5173
SESSION_DURATION_DAYS=7
# Replace with a unique random value of at least 32 characters in production.
RATE_LIMIT_HMAC_SECRET=development-only-rate-limit-key-change-before-production
